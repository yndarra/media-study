@echo off
chcp 65001 >nul
rem Этап 1 для нового видео: скачивает его в максимальном качестве, делает
rem копию для редактора, распознаёт речь, режет на фразы и открывает редактор.
rem Ссылку можно передать аргументом или ввести, когда спросит. Длинное видео
rem обрабатывается долго (распознавание часовой записи - десятки минут);
rem если окно закрыть или процесс оборвётся, повторный запуск с той же ссылкой
rem продолжит с места обрыва.

cd /d "%~dp0"
set "URL=%~1"
if "%URL%"=="" set /p "URL=Ссылка на видео: "
if "%URL%"=="" exit /b 0

py -3.12 -m phase1_ingest.cli "%URL%"
if errorlevel 1 (
    echo.
    echo Этап 1 не удался - запустите снова с той же ссылкой, он продолжит с места обрыва.
    pause
    exit /b 1
)
echo.
echo Готово. Открываю редактор...
call "%~dp0open_editor.bat"
exit /b 0
